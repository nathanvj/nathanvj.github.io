---
/**
 * Ruby Run's scoreboard and card. It sits where the hero buttons are and takes
 * their place while you play: the scores in one row, and under it a small card
 * to start, carry on or try again, kept above the street so Ruby stays in
 * view. scripts/run/play.ts runs it; the words are in src/content/run.ts.
 */
import { run } from '../../content/run';
import PixelIcon from './PixelIcon.astro';
---
<div class="run" data-run hidden>
  <div class="hud">
    <span class="score"><PixelIcon name="bone" class="score-icon" /><b data-run-bones>0</b></span>
    <span class="score"><b data-run-metres>0 m</b></span>
    <span class="badge badge-now" data-run-best-badge hidden>{run.newBest}</span>
    <span class="best" data-run-best></span>
    <button type="button" class="icon-btn pause" data-run-pause aria-label={run.pause} title={`${run.pause} (P)`}><span></span></button>
  </div>

  <div class="card tile" data-run-card>
    <div class="words">
      <h2 data-run-heading>{run.title}</h2>
      <p class="text" data-run-text>{run.intro}</p>
      <p class="controls" data-run-controls>{run.controls.keys}</p>
    </div>
    <div class="buttons">
      <button type="button" class="btn btn-primary" data-run-go>{run.start}</button>
      <button type="button" class="btn" data-run-share hidden>{run.share}</button>
    </div>
    <button type="button" class="stop" data-run-stop aria-label={run.stop} title={`${run.stop} (Esc)`}>×</button>
  </div>
  <p class="sr-only" role="status" data-run-live></p>
</div>

<style>
  .run {
    position: absolute;
    left: 0;
    top: 0;
    width: min(640px, 100%);
  }
  .run[hidden] { display: none; }

  /* ---- the scores, where the buttons were */
  /* on the right, out of the way of her jumps */
  .hud { display: flex; justify-content: flex-end; align-items: center; gap: 12px; min-height: 46px; }
  .score {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px 7px;
    background: var(--tile);
    color: var(--text);
    font: 600 18px/1 var(--font-display);
    box-shadow:
      0 calc(var(--px) * -1) 0 0 var(--edge),
      calc(var(--px) * -1) 0 0 0 var(--edge),
      var(--px) 0 0 0 var(--edge),
      0 var(--px) 0 0 var(--edge);
  }
  .score :global(.score-icon) { width: 22px; height: 22px; }
  /* a score hops when it goes up */
  .score:global(.bump) { animation: bump 0.24s steps(2); }
  @keyframes bump { 50% { transform: translateY(calc(var(--px) * -2)); } }
  @media (prefers-reduced-motion: reduce) { .score:global(.bump) { animation: none; } }
  .best { font: 500 15px/1 var(--font-display); color: var(--text-soft); }
  .badge[hidden] { display: none; }
  /* two pixel bars */
  .pause span { display: block; width: 12px; height: 14px; border-inline: 4px solid currentColor; }
  :global(:root[data-run='ready']) .hud { display: none; }
  :global(:root:not([data-run='running'])) .pause { display: none; }

  /* ---- start, paused, game over: words on the left, buttons on the right */
  .card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px 20px;
    margin: 12px 0 0;
    padding: 14px 52px 14px 18px;
  }
  :global(:root[data-run='ready']) .card { margin-top: 0; }
  .card[hidden] { display: none; }
  .card h2 { font-size: 24px; margin: 0; }
  .text { margin: 6px 0 0; font-size: 15px; line-height: 1.45; color: var(--text-soft); }
  .controls { margin: 6px 0 0; font-size: 13px; color: var(--text-soft); }
  .text[hidden], .controls[hidden] { display: none; }
  .buttons { display: flex; flex-wrap: wrap; justify-content: end; gap: 10px; }
  .buttons .btn { min-height: 42px; padding: 10px 16px 9px; font-size: 17px; margin-bottom: calc(var(--px) * 3); }
  .buttons .btn[hidden] { display: none; }
  .stop {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 32px;
    height: 32px;
    border: 0;
    background: transparent;
    color: var(--text);
    font: 700 22px/1 var(--font-display);
    cursor: pointer;
  }
  .stop:hover { background: var(--mist); }

  /* phones: Ruby runs on the far left, so everything keeps clear of her */
  @media (max-width: 640px) {
    .hud { gap: 8px; min-height: 40px; }
    .score { padding: 6px 9px 5px; font-size: 16px; }
    .best { font-size: 13px; }
    .card {
      grid-template-columns: 1fr;
      gap: 8px;
      width: calc(100% - 56px);
      margin-left: auto;
      padding: 10px 40px 10px 12px;
    }
    .card h2 { font-size: 20px; }
    .text { display: none; }
    .controls { font-size: 12px; margin-top: 4px; }
    .buttons { justify-content: start; gap: 8px; }
    .buttons .btn { min-height: 38px; padding: 8px 12px 7px; font-size: 15px; }
    .stop { top: 2px; right: 2px; }
  }
</style>
