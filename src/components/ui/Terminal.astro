---
/** The terminal window (press ` or the >_ button). Behaviour lives in scripts/ui/terminal.ts. */
import { terminal } from '../../content/ruby';
---
<div class="term pixel-box" data-terminal role="dialog" aria-label="Terminal" hidden>
  <div class="bar" data-terminal-bar data-platform="fixed" data-say="Type help.">
    <span class="title">{terminal.title}</span>
    <button type="button" class="close" data-terminal-close aria-label="Close the terminal">×</button>
  </div>
  <div class="out" data-terminal-out aria-live="polite"></div>
  <form class="line" autocomplete="off">
    <label for="term-in" class="prompt">{terminal.prompt}</label>
    <input id="term-in" type="text" spellcheck="false" autocapitalize="off" autocomplete="off" />
  </form>
</div>

<style>
  .term {
    --depth: var(--deep);
    position: fixed;
    right: 24px;
    bottom: 28px;
    z-index: var(--z-terminal);
    display: flex;
    flex-direction: column;
    width: min(580px, calc(100vw - 32px));
    height: min(380px, 70vh);
    background: var(--term-bg);
    color: var(--term-text);
  }
  .term[hidden] { display: none; }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 6px 6px 14px;
    background: var(--mist);
    color: var(--text);
    border-bottom: var(--px) solid var(--edge);
    cursor: move;
    touch-action: none;
    user-select: none;
  }
  .title { font: 600 16px/1 var(--font-display); }
  .close { width: 30px; height: 30px; border: 0; background: transparent; color: var(--text); font: 700 22px/1 var(--font-display); cursor: pointer; }
  .close:hover { background: var(--tile); }
  .out { flex: 1; overflow-y: auto; padding: 12px 16px 0; font: 21px/1.15 var(--font-term); white-space: pre-wrap; word-break: break-word; }
  .out :global(.dim) { color: var(--term-dim); }
  .out :global(.hl) { color: var(--term-hl); }
  .out :global(.ok) { color: var(--term-ok); }
  .out :global(a) { color: var(--term-link); }
  .line { display: flex; gap: 10px; align-items: baseline; padding: 6px 16px 12px; font: 21px/1.15 var(--font-term); }
  .prompt { color: var(--term-prompt); white-space: nowrap; }
  input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: #fff; font: inherit; caret-color: var(--term-prompt); }
  @media (max-width: 640px) {
    .term { right: 16px; left: 16px; width: auto; bottom: 16px; height: 60vh; }
  }
</style>
